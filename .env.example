# Copy to .env and fill in. .env is gitignored, never commit a real key.

# KeeperHub base URL. Paths in the code already include /api, so do NOT append
# /api here. Setting this to https://app.keeperhub.com/api produces /api/api and
# a 404 (the quickstart's doctor step checks for exactly this).
KEEPERHUB_BASE_URL=https://app.keeperhub.com

# A throwaway EOA private key (0x-prefixed, 32 bytes). For a first run generate a
# fresh one, it needs no funds: run `npm run keygen` and paste the line here.
# Signing in with this wallet creates the account, its organization and the org
# wallet on first use. Keep it out of source control.
ETH_PRIVATE_KEY=

# Chain to execute on. 84532 = Base Sepolia (testnet, sponsored gas, costs
# nothing for the zero-value first transaction). 8453 = Base mainnet.
CHAIN_ID=84532

# Optional. Recipient for the first transfer. Defaults to the org wallet itself
# (a zero-value self-transfer), which is what lets an empty wallet land a real tx.
RECIPIENT=

# Optional. Amount in human units. Defaults to 0 for the first run. Raise it only
# after the org wallet the run prints has been funded.
AMOUNT=0
